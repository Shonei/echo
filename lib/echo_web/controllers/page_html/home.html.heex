<.flash_group flash={@flash} />

<div class="min-h-screen bg-gradient-to-br from-purple-50 to-blue-50">
  <div class="container mx-auto px-4 py-16">
    <!-- Title -->
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">Random Applications</h1>
      <p class="text-xl text-gray-600">A collection of useful tools and utilities</p>
    </div>

    <!-- APP Section -->
    <div class="mb-16">
      <h2 class="text-3xl font-semibold text-gray-800 mb-8 text-center">APP</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a href="/echo/request" class="group block">
          <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 text-center">
            <div class="mb-6">
              <.icon name="hero-signal" class="h-16 w-16 mx-auto text-blue-500" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Echo UI</h3>
            <p class="text-gray-600">View and manage request history</p>
          </div>
        </a>

        <a href="/chat" class="group block">
          <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 text-center">
            <div class="mb-6">
              <.icon name="hero-chat-bubble-left-right" class="h-16 w-16 mx-auto text-purple-500" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Real-time Chat</h3>
            <p class="text-gray-600">Join chat rooms and talk with others</p>
          </div>
        </a>

        <a href="/assets" class="group block">
          <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 text-center">
            <div class="mb-6">
              <.icon name="hero-photo" class="h-16 w-16 mx-auto text-pink-500" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Asset Manager</h3>
            <p class="text-gray-600">Upload, view, and manage your files</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Dev Section -->
    <div>
      <h2 class="text-3xl font-semibold text-gray-800 mb-8 text-center">Dev</h2>
      <div class="flex justify-center">
        <a href="/dev/dashboard" class="group block max-w-sm w-full">
          <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 text-center">
            <div class="mb-6">
              <.icon name="hero-chart-bar" class="h-16 w-16 mx-auto text-green-500" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Dashboard</h3>
            <p class="text-gray-600">Development tools and metrics</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
