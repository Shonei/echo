<div class="flex justify-between items-center mb-4">
  <.header class="mb-0">
    Real-time Chat
    <:subtitle>Choose a room to start chatting</:subtitle>
  </.header>

  <div class="flex gap-2">
    <.link
      navigate={~p"/chat/rooms/new"}
      class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
    >
      Create Room
    </.link>
    <.link
      navigate={~p"/users"}
      class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
    >
      Users
    </.link>
  </div>
</div>

<div class="max-w-4xl mx-auto">
  <%= if @rooms == [] do %>
    <div class="text-center py-12">
      <p class="text-gray-500 text-lg mb-4">No chat rooms available yet.</p>
      <.link
        navigate={~p"/chat/rooms/new"}
        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
      >
        Create the first room
      </.link>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      <%= for room <- @rooms do %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= room.name %></h3>
          <p class="text-gray-600 mb-2"><%= room.description %></p>
          <%= if room.type do %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 mb-4">
              <%= room.type %>
            </span>
          <% end %>
          <div class="mt-4 flex gap-2">
            <.link
              navigate={~p"/chat/#{room.name}"}
              class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              Join Room
            </.link>
            <.link
              navigate={~p"/chat/rooms/#{room.id}/edit"}
              class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              Edit
            </.link>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
