<.header>
  Edit User
  <:subtitle>Update user information</:subtitle>
  <:actions>
    <.link href={~p"/users/#{@user}"} class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
      Back to User
    </.link>
  </:actions>
</.header>

<div class="mt-8">
  <.simple_form :let={f} for={@changeset} action={~p"/users/#{@user}"} method="put">
    <.error :if={@changeset.action}>
      Oops, something went wrong! Please check the errors below.
    </.error>

    <.input field={f[:username]} type="text" label="Username" required />
    
    <.input 
      field={f[:type]} 
      type="select" 
      label="User Type" 
      options={[{"Regular User", "user"}, {"AI User", "ai"}, {"Admin User", "admin"}]}
      required 
    />

    <!-- Regular User Metadata -->
    <div id="regular_metadata" class="space-y-4">
      <label class="block text-sm font-medium text-gray-700">
        Metadata (JSON format)
      </label>
      <textarea
        name="user[metadata]"
        id="user_metadata"
        rows="6"
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
        placeholder='{"key": "value", "another_key": "another_value"}'
      ><%= if @metadata != %{} and @user.type != "ai", do: Jason.encode!(@metadata, pretty: true) %></textarea>
      <p class="text-sm text-gray-500">
        Enter metadata as JSON. Keys must be strings, values must be strings or numbers.
      </p>
    </div>

    <!-- AI User Specific Fields -->
    <div id="ai_metadata" class="space-y-4" style="display: none;">
      <h3 class="text-lg font-medium text-gray-900">AI Configuration</h3>

      <div>
        <label class="block text-sm font-medium text-gray-700">Model</label>
        <input
          type="text"
          name="ai_model"
          id="ai_model"
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
          placeholder="gemini-2.5-flash-lite"
          value={Map.get(@metadata, "model", "gemini-2.5-flash-lite")}
        />
        <p class="text-sm text-gray-500">The AI model to use for responses</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Prompt</label>
        <textarea
          name="ai_prompt"
          id="ai_prompt"
          rows="4"
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
          placeholder="You are a helpful assistant."
        ><%= Map.get(@metadata, "prompt", "You are a helpful assistant.") %></textarea>
        <p class="text-sm text-gray-500">The system prompt that defines the AI's behavior</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Temperature</label>
          <input
            type="number"
            name="ai_temperature"
            id="ai_temperature"
            step="0.1"
            min="0"
            max="2"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
            value={Map.get(@metadata, "temperature", "0.7")}
          />
          <p class="text-sm text-gray-500">Controls randomness (0.0-2.0)</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Max Tokens</label>
          <input
            type="number"
            name="ai_max_tokens"
            id="ai_max_tokens"
            min="1"
            max="4000"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
            value={Map.get(@metadata, "max_tokens", "1000")}
          />
          <p class="text-sm text-gray-500">Maximum response length</p>
        </div>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 mt-4">
      <h4 class="text-sm font-medium text-yellow-800 mb-2">Password Update (Optional):</h4>
      <.input field={f[:password]} type="password" label="New Password (leave blank to keep current)" />
    </div>

    <div class="bg-red-50 border border-red-200 rounded-md p-4 mt-4">
      <h4 class="text-sm font-medium text-red-800 mb-2">Authentication Required:</h4>
      <.input 
        field={f[:current_password]} 
        type="password" 
        label="Current Password" 
        required 
        placeholder="Enter your current password to confirm changes"
      />
      <p class="text-sm text-red-600 mt-1">
        You must enter your current password to update user information.
      </p>
    </div>

    <:actions>
      <.button>Update User</.button>
    </:actions>
  </.simple_form>
</div>

<script>
  // Initialize the form based on current user type
  document.addEventListener('DOMContentLoaded', function() {
    const userType = document.querySelector('select[name="user[type]"]').value;
    const regularMetadata = document.getElementById('regular_metadata');
    const aiMetadata = document.getElementById('ai_metadata');

    if (userType === 'ai') {
      regularMetadata.style.display = 'none';
      aiMetadata.style.display = 'block';
    } else {
      regularMetadata.style.display = 'block';
      aiMetadata.style.display = 'none';
    }
  });

  // Show/hide appropriate metadata fields based on user type
  document.querySelector('select[name="user[type]"]').addEventListener('change', function() {
    const regularMetadata = document.getElementById('regular_metadata');
    const aiMetadata = document.getElementById('ai_metadata');
    const metadataField = document.getElementById('user_metadata');

    if (this.value === 'ai') {
      regularMetadata.style.display = 'none';
      aiMetadata.style.display = 'block';
      // Clear the regular metadata field since we'll use AI fields
      metadataField.value = '';
    } else {
      regularMetadata.style.display = 'block';
      aiMetadata.style.display = 'none';
    }
  });

  // Add JSON validation for regular metadata
  document.getElementById('user_metadata').addEventListener('blur', function() {
    const value = this.value.trim();
    if (value && value !== '') {
      try {
        JSON.parse(value);
        this.classList.remove('border-red-300');
        this.classList.add('border-gray-300');
      } catch (e) {
        this.classList.remove('border-gray-300');
        this.classList.add('border-red-300');
      }
    }
  });

  // Handle form submission to convert AI fields to metadata JSON
  document.querySelector('form').addEventListener('submit', function(e) {
    const userType = document.querySelector('select[name="user[type]"]').value;

    if (userType === 'ai') {
      const model = document.getElementById('ai_model').value;
      const prompt = document.getElementById('ai_prompt').value;
      const temperature = document.getElementById('ai_temperature').value;
      const maxTokens = document.getElementById('ai_max_tokens').value;

      const aiMetadata = {
        "model": model,
        "prompt": prompt,
        "temperature": temperature,
        "max_tokens": maxTokens
      };

      // Set the metadata field with the AI configuration
      document.getElementById('user_metadata').value = JSON.stringify(aiMetadata);
    }
  });
</script>

<script>
  // Add some basic JSON validation
  document.getElementById('user_metadata').addEventListener('blur', function() {
    const value = this.value.trim();
    if (value && value !== '') {
      try {
        JSON.parse(value);
        this.classList.remove('border-red-300');
        this.classList.add('border-gray-300');
      } catch (e) {
        this.classList.remove('border-gray-300');
        this.classList.add('border-red-300');
      }
    }
  });
</script>
