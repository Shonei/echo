<div class="max-w-7xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Request History</h1>
    <p class="mt-2 text-gray-600">View all requests made to the Echo system</p>
  </div>

  <!-- Filters -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Filters</h2>
    <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label for="method" class="block text-sm font-medium text-gray-700">Method</label>
        <select name="method" id="method" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
          <option value="">All Methods</option>
          <option value="GET" selected={@filters["method"] == "GET"}>GET</option>
          <option value="POST" selected={@filters["method"] == "POST"}>POST</option>
          <option value="PUT" selected={@filters["method"] == "PUT"}>PUT</option>
          <option value="PATCH" selected={@filters["method"] == "PATCH"}>PATCH</option>
          <option value="DELETE" selected={@filters["method"] == "DELETE"}>DELETE</option>
        </select>
      </div>
      
      <div>
        <label for="url_path" class="block text-sm font-medium text-gray-700">URL Path</label>
        <input type="text" name="url_path" id="url_path" value={@filters["url_path"] || ""} 
               placeholder="e.g., /api/users" 
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      </div>
      
      <div>
        <label for="content_type" class="block text-sm font-medium text-gray-700">Content Type</label>
        <select name="content_type" id="content_type" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
          <option value="">All Types</option>
          <option value="application/json" selected={@filters["content_type"] == "application/json"}>application/json</option>
          <option value="application/xml" selected={@filters["content_type"] == "application/xml"}>application/xml</option>
          <option value="text/plain" selected={@filters["content_type"] == "text/plain"}>text/plain</option>
          <option value="application/x-www-form-urlencoded" selected={@filters["content_type"] == "application/x-www-form-urlencoded"}>application/x-www-form-urlencoded</option>
        </select>
      </div>
      
      <div class="flex items-end">
        <button type="submit" class="w-full bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          Filter
        </button>
      </div>
    </form>
  </div>

  <!-- Requests Table -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Requests</h2>
    </div>
    
    <%= if Enum.empty?(@requests) do %>
      <div class="px-6 py-12 text-center">
        <p class="text-gray-500">No requests found matching your criteria.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Method</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">URL Path</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Content Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Body Preview</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for request <- @requests do %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class={"inline-flex px-2 py-1 text-xs font-semibold rounded-full #{method_badge_class(request.method)}"}>
                    <%= request.method %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-mono">
                  <%= request.url_path %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= request.content_type %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500 max-w-xs">
                  <div class="truncate">
                    <%= truncate_string(request.body, 50) %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= format_timestamp(request.inserted_at) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <a href={~p"/echo/request/#{request.id}"} class="text-indigo-600 hover:text-indigo-900">
                    View Details
                  </a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <%= if @total_pages > 1 do %>
    <div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6 mt-6 rounded-lg shadow">
      <div class="flex-1 flex justify-between sm:hidden">
        <%= if @current_page > 1 do %>
          <a href={~p"/echo/request?#{Map.put(@filters, "page", @current_page - 1)}"} 
             class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            Previous
          </a>
        <% end %>
        <%= if @current_page < @total_pages do %>
          <a href={~p"/echo/request?#{Map.put(@filters, "page", @current_page + 1)}"} 
             class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            Next
          </a>
        <% end %>
      </div>
      <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-gray-700">
            Page <span class="font-medium"><%= @current_page %></span> of <span class="font-medium"><%= @total_pages %></span>
          </p>
        </div>
        <div>
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <%= if @current_page > 1 do %>
              <a href={~p"/echo/request?#{Map.put(@filters, "page", @current_page - 1)}"} 
                 class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                Previous
              </a>
            <% end %>
            <%= if @current_page < @total_pages do %>
              <a href={~p"/echo/request?#{Map.put(@filters, "page", @current_page + 1)}"} 
                 class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                Next
              </a>
            <% end %>
          </nav>
        </div>
      </div>
    </div>
  <% end %>
</div>
