<.header>
  User Details
  <:subtitle>View user information</:subtitle>
  <:actions>
    <.link href={~p"/users/#{@user}/edit"} class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
      Edit User
    </.link>
    <.link href={~p"/users"} class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded ml-2">
      Back to Users
    </.link>
  </:actions>
</.header>

<div class="mt-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        <%= @user.username %>
      </h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">
        User information and metadata
      </p>
    </div>
    <div class="border-t border-gray-200">
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            User ID
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= @user.id %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            Username
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= @user.username %>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            Type
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <span class={[
              "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
              case @user.type do
                "ai" -> "bg-purple-100 text-purple-800"
                "admin" -> "bg-red-100 text-red-800"
                _ -> "bg-gray-100 text-gray-800"
              end
            ]}>
              <%= @user.type %>
            </span>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            Created At
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= Calendar.strftime(@user.inserted_at, "%Y-%m-%d %H:%M:%S UTC") %>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            Last Updated
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= Calendar.strftime(@user.updated_at, "%Y-%m-%d %H:%M:%S UTC") %>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">
            Metadata
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <%= if @metadata == %{} do %>
              <span class="text-gray-400 italic">No metadata</span>
            <% else %>
              <pre class="bg-gray-100 p-3 rounded text-xs overflow-x-auto"><%= Jason.encode!(@metadata, pretty: true) %></pre>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-end space-x-3">
  <.link 
    href={~p"/users/#{@user}"} 
    method="delete" 
    data-confirm="Are you sure you want to delete this user? This action cannot be undone."
    class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded"
  >
    Delete User
  </.link>
</div>
