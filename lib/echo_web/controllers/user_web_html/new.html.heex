<.header>
  Create New User
  <:subtitle>Add a new user to the system</:subtitle>
  <:actions>
    <.link href={~p"/users"} class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
      Back to Users
    </.link>
  </:actions>
</.header>

<div class="mt-8">
  <.simple_form :let={f} for={@changeset} action={~p"/users"}>
    <.error :if={@changeset.action}>
      Oops, something went wrong! Please check the errors below.
    </.error>

    <.input field={f[:username]} type="text" label="Username" required />
    <.input field={f[:password]} type="password" label="Password" required />
    
    <.input 
      field={f[:type]} 
      type="select" 
      label="User Type" 
      options={[{"Regular User", "user"}, {"AI User", "ai"}, {"Admin User", "admin"}]}
      required 
    />

    <div class="space-y-4">
      <label class="block text-sm font-medium text-gray-700">
        Metadata (JSON format)
      </label>
      <textarea 
        name="user[metadata]" 
        id="user_metadata"
        rows="6" 
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
        placeholder='{"key": "value", "another_key": "another_value"}'
      ></textarea>
      <p class="text-sm text-gray-500">
        Enter metadata as JSON. For AI users, include "model" and "system_props" fields.
      </p>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-md p-4 mt-4">
      <h4 class="text-sm font-medium text-blue-800 mb-2">AI User Metadata Example:</h4>
      <pre class="text-xs text-blue-700 bg-blue-100 p-2 rounded overflow-x-auto"><%= raw ~s|{
  "model": "gpt-4",
  "system_props": {
    "temperature": 0.7,
    "max_tokens": 1000,
    "system_prompt": "You are a helpful assistant."
  }
}| %></pre>
    </div>

    <:actions>
      <.button>Create User</.button>
    </:actions>
  </.simple_form>
</div>

<script>
  // Add some basic JSON validation
  document.getElementById('user_metadata').addEventListener('blur', function() {
    const value = this.value.trim();
    if (value && value !== '') {
      try {
        JSON.parse(value);
        this.classList.remove('border-red-300');
        this.classList.add('border-gray-300');
      } catch (e) {
        this.classList.remove('border-gray-300');
        this.classList.add('border-red-300');
      }
    }
  });

  // Auto-populate metadata based on user type selection
  document.querySelector('select[name="user[type]"]').addEventListener('change', function() {
    const metadataField = document.getElementById('user_metadata');
    if (this.value === 'ai' && !metadataField.value.trim()) {
      metadataField.value = JSON.stringify({
        "model": "gpt-4",
        "system_props": {
          "temperature": 0.7,
          "max_tokens": 1000,
          "system_prompt": "You are a helpful assistant."
        }
      }, null, 2);
    }
  });
</script>
