<.header>
  <%= String.capitalize(@type) %> Users
  <:subtitle>Users of type: <%= @type %></:subtitle>
  <:actions>
    <.link href={~p"/users"} class="bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
      All Users
    </.link>
    <.link href={~p"/users/new"} class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded ml-2">
      New User
    </.link>
  </:actions>
</.header>

<div class="mt-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul class="divide-y divide-gray-200">
      <%= for user <- @users do %>
        <li>
          <div class="px-4 py-4 flex items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class={[
                  "h-10 w-10 rounded-full flex items-center justify-center",
                  case @type do
                    "ai" -> "bg-purple-300"
                    "admin" -> "bg-red-300"
                    _ -> "bg-gray-300"
                  end
                ]}>
                  <span class="text-sm font-medium text-gray-700">
                    <%= String.first(user.username) |> String.upcase() %>
                  </span>
                </div>
              </div>
              <div class="ml-4">
                <div class="text-sm font-medium text-gray-900">
                  <%= user.username %>
                </div>
                <div class="text-sm text-gray-500">
                  Created: <%= Calendar.strftime(user.inserted_at, "%Y-%m-%d %H:%M") %>
                </div>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <.link 
                href={~p"/users/#{user}"} 
                class="text-blue-600 hover:text-blue-900 text-sm font-medium"
              >
                View
              </.link>
              <.link 
                href={~p"/users/#{user}/edit"} 
                class="text-green-600 hover:text-green-900 text-sm font-medium"
              >
                Edit
              </.link>
              <.link 
                href={~p"/users/#{user}"} 
                method="delete" 
                data-confirm="Are you sure you want to delete this user?"
                class="text-red-600 hover:text-red-900 text-sm font-medium"
              >
                Delete
              </.link>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <%= if @users == [] do %>
    <div class="text-center py-12">
      <div class="text-gray-500">
        <p class="text-lg">No <%= @type %> users found</p>
        <p class="mt-2">
          <.link href={~p"/users/new"} class="text-blue-600 hover:text-blue-800">
            Create a new <%= @type %> user
          </.link>
        </p>
      </div>
    </div>
  <% end %>
</div>
