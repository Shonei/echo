<.header>
  User Management
  <:subtitle>Manage all users in the system</:subtitle>
  <:actions>
    <.link href={~p"/users/new"} class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
      New User
    </.link>
  </:actions>
</.header>

<div class="mt-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul class="divide-y divide-gray-200">
      <%= for user <- @users do %>
        <li>
          <div class="px-4 py-4 flex items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center">
                  <span class="text-sm font-medium text-gray-700">
                    <%= String.first(user.username) |> String.upcase() %>
                  </span>
                </div>
              </div>
              <div class="ml-4">
                <div class="text-sm font-medium text-gray-900">
                  <%= user.username %>
                </div>
                <div class="text-sm text-gray-500">
                  Type: <%= user.type %> • Created: <%= Calendar.strftime(user.inserted_at, "%Y-%m-%d %H:%M") %>
                </div>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <.link 
                href={~p"/users/#{user}"} 
                class="text-blue-600 hover:text-blue-900 text-sm font-medium"
              >
                View
              </.link>
              <.link 
                href={~p"/users/#{user}/edit"} 
                class="text-green-600 hover:text-green-900 text-sm font-medium"
              >
                Edit
              </.link>
              <.link 
                href={~p"/users/#{user}"} 
                method="delete" 
                data-confirm="Are you sure you want to delete this user?"
                class="text-red-600 hover:text-red-900 text-sm font-medium"
              >
                Delete
              </.link>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <%= if @users == [] do %>
    <div class="text-center py-12">
      <div class="text-gray-500">
        <p class="text-lg">No users found</p>
        <p class="mt-2">
          <.link href={~p"/users/new"} class="text-blue-600 hover:text-blue-800">
            Create your first user
          </.link>
        </p>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-8">
  <h3 class="text-lg font-medium text-gray-900 mb-4">Filter by Type</h3>
  <div class="flex space-x-4">
    <.link href={~p"/users/type/user"} class="bg-gray-200 hover:bg-gray-300 px-3 py-2 rounded text-sm">
      Regular Users
    </.link>
    <.link href={~p"/users/type/ai"} class="bg-purple-200 hover:bg-purple-300 px-3 py-2 rounded text-sm">
      AI Users
    </.link>
    <.link href={~p"/users/type/admin"} class="bg-red-200 hover:bg-red-300 px-3 py-2 rounded text-sm">
      Admin Users
    </.link>
  </div>
</div>
