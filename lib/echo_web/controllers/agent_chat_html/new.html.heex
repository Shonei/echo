<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Create AI Agent</h1>
    <p class="text-sm text-gray-500 mt-2">Configure a new AI agent and start a conversation.</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <.form :let={_f} for={%{}} as={:agent} action={~p"/agent-chat"} method="post" class="space-y-6">
      
      <div>
        <label for="agent_model" class="block text-sm font-medium text-gray-700">Model</label>
        <select id="agent_model" name="agent[model]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
          <option value="gemini-3.1-pro-preview">Gemini 3.1 Pro Preview</option>
          <option value="gemini-3-pro-image-preview">Gemini 3 Pro Image Preview</option>
        </select>
      </div>

      <div>
        <label for="agent_system_prompt" class="block text-sm font-medium text-gray-700">System Prompt</label>
        <textarea id="agent_system_prompt" name="agent[system_prompt]" rows="4" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" placeholder="You are a helpful assistant..."></textarea>
      </div>

      <div>
        <label for="agent_temperature" class="block text-sm font-medium text-gray-700">Temperature (0.0 - 2.0)</label>
        <input type="number" step="0.1" min="0" max="2" value="0.7" id="agent_temperature" name="agent[temperature]" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Response Modalities</label>
        <div class="flex items-center space-x-4">
          <div class="flex items-center">
            <input type="checkbox" id="modality_text" name="agent[response_modalities][text]" value="true" checked class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
            <label for="modality_text" class="ml-2 block text-sm text-gray-900">Text</label>
          </div>
          <div class="flex items-center">
            <input type="checkbox" id="modality_image" name="agent[response_modalities][image]" value="true" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
            <label for="modality_image" class="ml-2 block text-sm text-gray-900">Image</label>
          </div>
        </div>
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
          Start Conversation
        </button>
      </div>
      
    </.form>
  </div>
</div>
