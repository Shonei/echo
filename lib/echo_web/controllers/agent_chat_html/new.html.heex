<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-8 flex justify-between items-start gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Create AI Agent</h1>
      <p class="text-sm text-gray-500 mt-2">Configure a new AI agent and start a conversation.</p>
    </div>
    <a href="/" class="text-blue-600 hover:text-blue-800">Home</a>
  </div>

  <div :if={@presets != []} class="mb-6 bg-blue-50 border border-blue-100 rounded-xl p-4">
    <p class="text-sm font-medium text-gray-900">Start from a preset</p>
    <p class="text-xs text-gray-600 mt-1">
      Fills the form in below, so you can see and adjust what it sets before creating.
    </p>
    <div class="mt-3 flex flex-wrap gap-3">
      <a
        :for={preset <- @presets}
        href={~p"/agent-chat/new?preset=#{preset.key}"}
        class={[
          "px-3 py-2 rounded-lg text-sm font-medium border",
          if(@preset && @preset.key == preset.key,
            do: "bg-blue-600 text-white border-blue-600",
            else: "bg-white text-blue-700 border-blue-200 hover:bg-blue-100"
          )
        ]}
        title={preset.description}
      >
        {preset.label}
      </a>
      <a
        :if={@preset}
        href={~p"/agent-chat/new"}
        class="px-3 py-2 rounded-lg text-sm text-gray-600 hover:text-gray-900"
      >
        Clear
      </a>
    </div>
    <p :if={@preset} class="mt-3 text-xs text-gray-600">{@preset.description}</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <.form
      :let={_f}
      for={%{}}
      as={:agent}
      action={~p"/agent-chat"}
      method="post"
      class="space-y-8"
      id="agent-form"
    >
      <section class="space-y-6">
        <div>
          <label for="agent_provider" class="block text-sm font-medium text-gray-700">
            Provider
          </label>
          <select
            id="agent_provider"
            name="agent[provider]"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
          >
            <option :for={{label, value} <- @providers} value={value}>{label}</option>
          </select>
          <p class="mt-1 text-xs text-gray-500">
            Which backend answers this conversation. The model list and the tools below change
            with it.
          </p>
        </div>

        <div data-provider="gemini">
          <label for="agent_model" class="block text-sm font-medium text-gray-700">Model</label>
          <select
            id="agent_model"
            name="agent[model]"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
          >
            <option :for={{label, value} <- @models} value={value}>{label}</option>
          </select>
          <p class="mt-1 text-xs text-gray-500">
            Leave the default unless you need something specific. Only image-capable models can return images.
          </p>
        </div>

        <div data-provider="openrouter" class="space-y-3">
          <div>
            <label for="agent_openrouter_model" class="block text-sm font-medium text-gray-700">
              Model
            </label>
            <select
              :if={@openrouter_models != []}
              id="agent_openrouter_model"
              name="agent[openrouter_model]"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm font-mono"
            >
              <optgroup label="Supports tools">
                <option
                  :for={model <- Enum.filter(@openrouter_models, & &1.tools?)}
                  value={model.id}
                >
                  {model.name} — {model.id}
                </option>
              </optgroup>
              <optgroup label="Text only (cannot call tools)">
                <option
                  :for={model <- Enum.reject(@openrouter_models, & &1.tools?)}
                  value={model.id}
                >
                  {model.name} — {model.id}
                </option>
              </optgroup>
            </select>
            <p :if={@openrouter_models != []} class="mt-1 text-xs text-gray-500">
              Live from OpenRouter's catalogue. Models under "Text only" ignore every tool below.
            </p>
            <p
              :if={@openrouter_models == []}
              class="mt-1 text-xs text-amber-700 bg-amber-50 border border-amber-100 rounded-md p-2"
            >
              Couldn't reach OpenRouter's model list, so type a slug below instead.
            </p>
          </div>

          <div>
            <label
              for="agent_openrouter_model_custom"
              class="block text-sm font-medium text-gray-700"
            >
              Or type a slug
            </label>
            <input
              type="text"
              id="agent_openrouter_model_custom"
              name="agent[openrouter_model_custom]"
              placeholder="openai/gpt-5.6-luna"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm font-mono"
            />
            <p class="mt-1 text-xs text-gray-500">
              Wins over the dropdown when filled, so a model too new to be listed is still
              reachable. OpenRouter has no default model — one of these two must be set.
            </p>
          </div>
        </div>

        <div>
          <label for="agent_system_prompt" class="block text-sm font-medium text-gray-700">
            System Prompt
          </label>
          <textarea
            id="agent_system_prompt"
            name="agent[system_prompt]"
            rows="8"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm font-mono"
            placeholder="You are a helpful assistant..."
          >{@preset && @preset.system_prompt}</textarea>
          <p class="mt-1 text-xs text-gray-500">Optional. Sent as the system instruction.</p>
        </div>
      </section>

      <section class="border-t border-gray-100 pt-6">
        <h2 class="text-sm font-semibold text-gray-900">Generation</h2>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="agent_temperature" class="block text-sm font-medium text-gray-700">
              Temperature
            </label>
            <input
              type="number"
              step="0.1"
              min="0"
              max="2"
              value={(@preset && @preset.temperature) || 0.7}
              id="agent_temperature"
              name="agent[temperature]"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
            />
            <p class="mt-1 text-xs text-gray-500">0.0 – 2.0. Lower is more literal.</p>
          </div>

          <div>
            <label for="agent_max_output_tokens" class="block text-sm font-medium text-gray-700">
              Max Output Tokens
            </label>
            <input
              type="number"
              min="1"
              step="1"
              id="agent_max_output_tokens"
              name="agent[max_output_tokens]"
              placeholder="model default"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
            />
            <p class="mt-1 text-xs text-gray-500">Blank leaves the model's own cap in place.</p>
          </div>
        </div>

        <div data-provider="gemini" class="mt-4 space-y-3">
          <div class="flex items-center">
            <input
              type="checkbox"
              id="agent_thinking_enabled"
              name="agent[thinking_enabled]"
              value="true"
              class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="agent_thinking_enabled" class="ml-2 block text-sm text-gray-900">
              Enable thinking
            </label>
          </div>

          <div>
            <label for="agent_thinking_budget" class="block text-sm font-medium text-gray-700">
              Thinking Budget
            </label>
            <input
              type="number"
              min="1"
              step="1"
              id="agent_thinking_budget"
              name="agent[thinking_budget]"
              placeholder="model default"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
            />
            <p class="mt-1 text-xs text-gray-500">
              Token budget for reasoning. Ignored unless thinking is enabled.
            </p>
          </div>
        </div>
      </section>

      <section class="border-t border-gray-100 pt-6">
        <h2 class="text-sm font-semibold text-gray-900">Tools</h2>

        <div data-provider="gemini">
          <p class="mt-1 text-xs text-gray-500">
            Server-side tools run inside Gemini — the model decides when to use them and the results
            come back as grounding metadata on the reply.
          </p>

          <div class="mt-4 space-y-3">
            <div class="flex items-start">
              <input
                type="checkbox"
                id="tool_google_search"
                name="agent[tools][google_search]"
                value="true"
                class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
              />
              <div class="ml-2">
                <label for="tool_google_search" class="block text-sm text-gray-900">
                  Google Search
                </label>
                <p class="text-xs text-gray-500">
                  Lets the model search the web and ground its answer in the results.
                </p>
              </div>
            </div>

            <div class="flex items-start">
              <input
                type="checkbox"
                id="tool_url_context"
                name="agent[tools][url_context]"
                value="true"
                class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
              />
              <div class="ml-2">
                <label for="tool_url_context" class="block text-sm text-gray-900">
                  URL Context
                </label>
                <p class="text-xs text-gray-500">
                  Lets the model fetch and read pages you mention by URL in your messages.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div data-provider="openrouter">
          <p class="mt-1 text-xs text-gray-500">
            OpenRouter resolves these itself, inside a single response — no round-trip back to
            Echo. Results arrive as annotations on the reply and are kept in the message history.
            They cost money per call, so the engine is worth picking deliberately.
          </p>

          <div class="mt-4 space-y-4">
            <div>
              <div class="flex items-start">
                <input
                  type="checkbox"
                  id="tool_web_search"
                  name="agent[tools][web_search]"
                  value="true"
                  class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                />
                <div class="ml-2">
                  <label for="tool_web_search" class="block text-sm text-gray-900">
                    Web Search
                  </label>
                  <p class="text-xs text-gray-500">
                    Lets the model search the web. Results come back as url_citation annotations.
                  </p>
                </div>
              </div>

              <div class="ml-6 mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label
                    for="agent_web_search_engine"
                    class="block text-xs font-medium text-gray-700"
                  >
                    Engine
                  </label>
                  <select
                    id="agent_web_search_engine"
                    name="agent[web_search_engine]"
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                  >
                    <option value="auto">Auto (default)</option>
                    <option value="native">Native — the model provider's own search</option>
                    <option value="exa">Exa — $0.005 / request</option>
                    <option value="parallel">Parallel — $0.005 / request</option>
                  </select>
                </div>

                <div>
                  <label
                    for="agent_web_search_max_results"
                    class="block text-xs font-medium text-gray-700"
                  >
                    Max results
                  </label>
                  <input
                    type="number"
                    min="1"
                    step="1"
                    id="agent_web_search_max_results"
                    name="agent[web_search_max_results]"
                    placeholder="5"
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                  />
                </div>
              </div>
            </div>

            <div>
              <div class="flex items-start">
                <input
                  type="checkbox"
                  id="tool_web_fetch"
                  name="agent[tools][web_fetch]"
                  value="true"
                  class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                />
                <div class="ml-2">
                  <label for="tool_web_fetch" class="block text-sm text-gray-900">
                    Web Fetch
                  </label>
                  <p class="text-xs text-gray-500">
                    Lets the model pull the full content of a URL, typically one it just found by
                    searching.
                  </p>
                </div>
              </div>

              <div class="ml-6 mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label
                    for="agent_web_fetch_engine"
                    class="block text-xs font-medium text-gray-700"
                  >
                    Engine
                  </label>
                  <select
                    id="agent_web_fetch_engine"
                    name="agent[web_fetch_engine]"
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                  >
                    <option value="auto">Auto (default)</option>
                    <option value="native">Native — the model provider's own fetch</option>
                    <option value="openrouter">OpenRouter — plain HTTP, free</option>
                    <option value="exa">Exa — $0.001 / fetch</option>
                    <option value="parallel">Parallel — $0.001 / fetch</option>
                  </select>
                </div>

                <div>
                  <label
                    for="agent_web_fetch_max_content_tokens"
                    class="block text-xs font-medium text-gray-700"
                  >
                    Max content tokens
                  </label>
                  <input
                    type="number"
                    min="1"
                    step="1"
                    id="agent_web_fetch_max_content_tokens"
                    name="agent[web_fetch_max_content_tokens]"
                    placeholder="model default"
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                  />
                  <p class="mt-1 text-xs text-gray-500">
                    Caps how much of a page enters context.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <h3 class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-500">
          Run by Echo
        </h3>
        <p class="mt-1 text-xs text-gray-500">Works on either provider.</p>
        <div class="mt-3 space-y-3">
          <div class="flex items-start">
            <input
              type="checkbox"
              id="tool_http_request"
              name="agent[tools][http_request]"
              value="true"
              checked={@preset && "http_request" in @preset.tools}
              class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <div class="ml-2">
              <label for="tool_http_request" class="block text-sm text-gray-900">
                HTTP Request
              </label>
              <p class="text-xs text-gray-500">
                Lets the model call any public URL with any method, and see the status, headers, and
                body. Echo makes the request itself and hands the result straight back to the model,
                looping up to 5 times per message. Requests to private, internal, or loopback
                addresses are refused and large bodies are truncated.
              </p>
            </div>
          </div>
        </div>

        <h3 class="mt-6 text-xs font-semibold uppercase tracking-wide text-gray-500">
          Skills
        </h3>
        <p class="mt-1 text-xs text-gray-500">
          Let this agent write and read skills. A skill can never be granted these itself, or it
          could rewrite what it is allowed to do.
        </p>
        <div class="mt-3 space-y-3">
          <div :for={tool <- @skill_tools} class="flex items-start">
            <input
              type="checkbox"
              id={"tool_#{tool.name}"}
              name={"agent[tools][#{tool.name}]"}
              value="true"
              checked={@preset && tool.name in @preset.tools}
              class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <div class="ml-2">
              <label for={"tool_#{tool.name}"} class="block text-sm text-gray-900 font-mono">
                {tool.name}
              </label>
              <p class="text-xs text-gray-500">{tool.description}</p>
            </div>
          </div>
        </div>

        <p
          data-provider="gemini"
          class="mt-4 text-xs text-amber-700 bg-amber-50 border border-amber-100 rounded-md p-2"
        >
          Tools work on text models, and they can be combined freely — Google's and Echo's together
          in one agent is fine. Image-generating models cannot call tools at all, so leave these
          unticked when you pick one.
        </p>

        <details data-provider="openrouter" class="mt-4">
          <summary class="text-xs font-semibold uppercase tracking-wide text-gray-500 cursor-pointer">
            Advanced: extra tools as raw JSON
          </summary>
          <div class="mt-3">
            <textarea
              id="agent_openrouter_tools"
              name="agent[openrouter_tools]"
              rows="5"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm font-mono"
              placeholder={
                ~s([{"type": "openrouter:web_search", "parameters": {"allowed_domains": ["arxiv.org"]}}])
              }
            ></textarea>
            <p class="mt-1 text-xs text-gray-500">
              An escape hatch for options the checkboxes above don't cover, such as domain
              filtering. An object or an array of them, in OpenRouter's own tool syntax. Added on
              top of whatever is ticked.
            </p>
          </div>
        </details>
      </section>

      <section data-provider="gemini" class="border-t border-gray-100 pt-6">
        <h2 class="text-sm font-semibold text-gray-900">Response Modalities</h2>

        <div class="mt-4 flex items-center space-x-4">
          <div class="flex items-center">
            <input
              type="checkbox"
              id="modality_text"
              name="agent[response_modalities][text]"
              value="true"
              checked
              class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="modality_text" class="ml-2 block text-sm text-gray-900">Text</label>
          </div>
          <div class="flex items-center">
            <input
              type="checkbox"
              id="modality_image"
              name="agent[response_modalities][image]"
              value="true"
              class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="modality_image" class="ml-2 block text-sm text-gray-900">Image</label>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500">
          Image only works on an image-capable model, and those models cannot call tools — pick
          images or tools, not both. OpenRouter conversations are text-only.
        </p>
      </section>

      <div class="pt-2 flex justify-end">
        <button
          type="submit"
          class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          Start Conversation
        </button>
      </div>
    </.form>
  </div>
</div>
