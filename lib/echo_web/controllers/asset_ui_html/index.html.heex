<div class="px-4 py-10 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-semibold leading-6 text-gray-900">Asset Manager</h1>
      <p class="mt-2 text-sm text-gray-700">A list of all the uploaded assets including images, documents, and videos.</p>
    </div>
  </div>

  <div class="mt-8 bg-white p-6 shadow sm:rounded-lg">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Upload New Asset</h2>
    <form action={~p"/assets"} method="post" enctype="multipart/form-data" class="flex items-center space-x-4">
      <div class="flex-1">
        <label for="upload" class="sr-only">Choose file</label>
        <input type="file" name="upload" id="upload" class="block w-full text-sm text-gray-500
          file:mr-4 file:py-2 file:px-4
          file:rounded-md file:border-0
          file:text-sm file:font-semibold
          file:bg-indigo-50 file:text-indigo-700
          hover:file:bg-indigo-100
        " required />
      </div>

      <!-- CSRF protection -->
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <button type="submit" class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        Upload
      </button>
    </form>
  </div>

  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Preview</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Name / Path</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Content Type</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Uploaded At</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <%= for asset <- @assets do %>
                <tr>
                  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                    <%= if String.starts_with?(asset.content_type, "image/") do %>
                      <div class="h-16 w-16 flex-shrink-0 bg-gray-50 rounded-md overflow-hidden">
                        <img class="h-full w-full object-cover" src={"/api/v1/assets#{asset.url_suffix}"} alt="" loading="lazy" />
                      </div>
                    <% else %>
                      <div class="flex h-16 w-16 items-center justify-center rounded-md bg-gray-100">
                        <.icon name="hero-document" class="h-8 w-8 text-gray-400" />
                      </div>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <div class="font-medium text-gray-900"><%= asset.name %></div>
                    <div class="text-xs text-indigo-500 hover:text-indigo-700 max-w-[200px] truncate">
                      <a href={"/api/v1/assets#{asset.url_suffix}"} target="_blank">/api/v1/assets<%= asset.url_suffix %></a>
                    </div>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">
                      <%= asset.content_type %>
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                    <%= Calendar.strftime(asset.inserted_at, "%Y-%m-%d %H:%M") %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                    <div class="flex items-center justify-end gap-3">
                      <a href={~p"/assets/#{asset.id}"} class="text-indigo-600 hover:text-indigo-900">View</a>
                      <form action={~p"/assets/#{asset.id}"} method="post" class="inline-flex gap-2">
                        <input type="hidden" name="_method" value="delete" />
                        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
                        <button type="submit" data-confirm="Are you sure you want to delete this asset?" class="text-red-600 hover:text-red-900 font-semibold bg-red-50 px-2 py-1 rounded">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <%= if Enum.empty?(@assets) do %>
            <div class="text-center py-12 px-4 shadow rounded-lg max-w-full">
               <.icon name="hero-photo" class="mx-auto h-12 w-12 text-gray-400" />
               <h3 class="mt-2 text-sm font-semibold text-gray-900">No assets</h3>
               <p class="mt-1 text-sm text-gray-500">Get started by uploading a new file.</p>
            </div>
          <% end %>
        </div>

        <div class="mt-4 flex items-center justify-between px-4 sm:px-0">
          <div class="flex flex-1 justify-between sm:justify-end">
            <%= if @page > 1 do %>
              <a href={"/assets?page=#{@page - 1}"} class="relative inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Previous</a>
            <% else %>
              <button disabled class="relative inline-flex items-center rounded-md bg-gray-50 px-3 py-2 text-sm font-semibold text-gray-400 ring-1 ring-inset ring-gray-200 cursor-not-allowed">Previous</button>
            <% end %>
            <%= if @has_more do %>
              <a href={"/assets?page=#{@page + 1}"} class="relative ml-3 inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Next</a>
            <% else %>
              <button disabled class="relative ml-3 inline-flex items-center rounded-md bg-gray-50 px-3 py-2 text-sm font-semibold text-gray-400 ring-1 ring-inset ring-gray-200 cursor-not-allowed">Next</button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
